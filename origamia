#!/usr/bin/env python3
"""Command-line helper for building Origamia exercises and reports."""

from __future__ import annotations

import shutil
import subprocess
import sys
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parent
OUT_DIR = ROOT_DIR / "out"
BUILD_SCRIPT = ROOT_DIR / "zeof" / "build_exercises.js"
DASHBOARD_SCRIPT = ROOT_DIR / "src" / "assets" / "sql" / "build_project_dashboard.py"

USAGE = """Origamia CLI

Usage:
  python origamia <command> [options]

Commands:
  help, --help, -h     Show this help
  build-exercises      Build all exercises into out/format.json and out/images
  build-dashboard      Build the project report into out/dashboard
  dashboard, report    Aliases for build-dashboard
  build                Alias for build-exercises
  clean-out            Remove generated files from out/
  clean                Alias for clean-out
  rebuild-exercises    Clean out/ then build all exercises
  rebuild              Alias for rebuild-exercises

Examples:
  python origamia build
  python origamia dashboard
  python origamia rebuild --skip-dashboard
"""


def run(command: list[str]) -> None:
    subprocess.run(command, cwd=ROOT_DIR, check=True)


def clean_out() -> None:
    resolved_out = OUT_DIR.resolve()
    expected_out = (ROOT_DIR.resolve() / "out").resolve()
    if resolved_out != expected_out:
        raise RuntimeError(f"Refusing to clean unexpected output directory: {resolved_out}")

    OUT_DIR.mkdir(parents=True, exist_ok=True)
    for child in OUT_DIR.iterdir():
        if child.is_dir():
            shutil.rmtree(child)
        else:
            child.unlink()
    print(f"Cleaned {OUT_DIR}")


def build_exercises(args: list[str]) -> None:
    command = ["node", str(BUILD_SCRIPT)]
    if "--include-all" not in args:
        command.append("--include-all")
    run([*command, *args])


def build_dashboard(args: list[str]) -> None:
    run([sys.executable, str(DASHBOARD_SCRIPT), *args])


def main(args: list[str]) -> int:
    command = args[0] if args else "help"
    rest = args[1:]

    if command in {"help", "--help", "-h"}:
        print(USAGE)
        return 0
    if command in {"build-exercises", "build"}:
        build_exercises(rest)
        return 0
    if command in {"build-dashboard", "dashboard", "report"}:
        build_dashboard(rest)
        return 0
    if command in {"clean-out", "clean"}:
        clean_out()
        return 0
    if command in {"rebuild-exercises", "rebuild"}:
        clean_out()
        build_exercises(rest)
        return 0

    print(f"Unknown command: {command}\n", file=sys.stderr)
    print(USAGE, file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
