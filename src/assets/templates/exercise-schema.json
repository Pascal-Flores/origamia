{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://origamia.vittascience/schema/exercise.schema.json",
	"title": "Origamia Exercise",
	"type": "object",
	"additionalProperties": false,
	"required": ["number", "nom", "description", "contexte", "consigne", "type", "media", "link", "maxAttempts", "feedback", "feedbacks"],
	"properties": {
		"number": {
			"type": "integer",
			"minimum": 1
		},
		"nom": {
			"type": "string",
			"minLength": 1
		},
		"description": {
			"type": "string"
		},
		"contexte": {
			"type": "string",
			"minLength": 1
		},
		"consigne": {
			"type": "string",
			"minLength": 1
		},
		"type": {
			"type": "string",
			"enum": ["qcu", "qcm", "dd", "ddt", "ddc", "free", "interface"]
		},
		"text": {
			"type": "string",
			"minLength": 1
		},
		"responses": {
			"type": "object",
			"minProperties": 1,
			"additionalProperties": {
				"type": "string"
			}
		},
		"correctAnswers": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string"
			}
		},
		"correctAnswer": {
			"type": "string",
			"minLength": 1
		},
		"displayAnswer": {
			"type": "string",
			"minLength": 1
		},
		"items": {
			"type": "object",
			"minProperties": 1,
			"additionalProperties": {
				"type": "string"
			}
		},
		"categories": {
			"type": "object",
			"minProperties": 1,
			"additionalProperties": {
				"type": "object",
				"additionalProperties": false,
				"required": ["name", "correctItems"],
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1
					},
					"correctItems": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "string"
						}
					}
				}
			}
		},
		"media": {
			"type": "string",
			"enum": ["", "image", "interface"]
		},
		"link": {
			"type": "string"
		},
		"maxAttempts": {
			"type": "integer",
			"minimum": 1
		},
		"feedback": {
			"type": "string"
		},
		"feedbacks": {
			"type": "object",
			"required": ["final"],
			"properties": {
				"final": {
					"type": "string",
					"minLength": 1
				}
			},
			"patternProperties": {
				"^[1-9][0-9]*$": {
					"type": "string",
					"minLength": 1
				}
			},
			"additionalProperties": false
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"type": {
						"enum": ["qcu", "qcm", "dd"]
					}
				}
			},
			"then": {
				"required": ["responses", "correctAnswers"]
			}
		},
		{
			"if": {
				"properties": {
					"type": {
						"const": "ddt"
					}
				}
			},
			"then": {
				"required": ["text", "responses", "correctAnswers"]
			}
		},
		{
			"if": {
				"properties": {
					"type": {
						"const": "ddc"
					}
				}
			},
			"then": {
				"required": ["items", "categories"]
			}
		},
		{
			"if": {
				"properties": {
					"type": {
						"const": "free"
					}
				}
			},
			"then": {
				"required": ["correctAnswer", "displayAnswer"]
			}
		},
		{
			"if": {
				"properties": {
					"type": {
						"const": "interface"
					}
				}
			},
			"then": {
				"properties": {
					"media": {
						"const": "interface"
					}
				}
			}
		}
	]
}
